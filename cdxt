#!/usr/bin/env zsh
# cdxt — interactive on/off toggle for MCP servers and plugins in the
# Codex CLI config (~/.codex/config.toml).
# https://github.com/everton-dgn/cdxt
set -u
# Defensive: disable MULTIOS so a redirection combined with a pipe on the
# same fd can never duplicate a stream (zsh default behavior). Nothing in
# the script currently relies on either semantics.
setopt no_multios

CONFIG="${CODEX_CONFIG:-${CODEX_HOME:-$HOME/.codex}/config.toml}"
BACKUP_DIR="${CODEX_CONFIG_BACKUP_DIR:-${CODEX_HOME:-$HOME/.codex}/config.toml.backups}"
BACKUP_KEEP="${CODEX_CONFIG_BACKUP_KEEP:-20}"
SCRIPT_PATH="${0:A}"

# fzf 0.71+ is required for --id-nth (cursor tracking across reloads).
FZF_MIN_VERSION="0.71"
FZF_FOOTER='→ enable   •   ← disable   •   space toggle   •   enter/esc quit   •   cdxt help'

VERSION="1.0.0"

# Shared awk helpers, prepended to every awk program below.
#
# TOML table headers carry no positional meaning: `[plugins."x"]` names the
# same table whether it sits in column 1 or indented under an unrelated
# table written earlier in the file. Codex reindents ~/.codex/config.toml
# and nests most plugin headers under [notice], so anchoring on `^\[` drops
# them from the menu. Every structural test goes through this library.
#
# The helpers cover the rest of the shapes a hand-written line matcher gets
# wrong: a comment after the header, blanks around the dots, a dot inside a
# quoted key, `"enabled"` spelled as a quoted key, and header-looking lines
# inside a multi-line string.
#
# Literal single quotes would end this zsh string, so the awk regexes use
# the octal escape \047 for them.
AWK_LIB='
function ltrim(s) { sub(/^[[:space:]]+/, "", s); return s }
function rtrim(s) { sub(/[[:space:]]+$/, "", s); return s }
function trim(s)  { return rtrim(ltrim(s)) }

# A single TOML key: bare, basic-quoted, or literal-quoted.
function is_key(s) {
  return s ~ /^([A-Za-z0-9_-]+|"([^"\\]|\\.)*"|\047[^\047]*\047)$/
}

function unquote(s) {
  if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) return substr(s, 2, length(s) - 2)
  return s
}

function quote_run(s, i,   c, n) {
  c = substr(s, i, 1)
  n = 0
  while (substr(s, i + n, 1) == c) n++
  return n
}

# Multi-line string tracking, state in ML_IN / ML_DELIM. A """ or \047\047\047
# body may contain anything, including lines that look like a table header
# or an enabled key. A line that only opens a body is ordinary content and
# returns 0; the lines after it return 1 until the closing delimiter. The
# line is scanned so a delimiter inside a single-line string, after a #, or
# escaped as \""" in a basic body is not taken for one. ML_CODE receives the
# parts of the line outside any body, such as the ] after a closing
# delimiter, so the bracket count never reads body text.
function in_multiline(line,   was_in, i, c, q, run, from) {
  if (!ML_IN && index(line, "\"\"\"") == 0 && index(line, "\047\047\047") == 0) {
    ML_CODE = line
    return 0
  }
  if (ML_IN && index(line, ML_DELIM) == 0) {
    ML_CODE = ""
    return 1
  }

  was_in = ML_IN
  ML_CODE = ""
  from = 1
  q = ""
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (ML_IN) {
      if (c == "\\" && ML_DELIM == "\"\"\"") {
        i++
      } else if (c == substr(ML_DELIM, 1, 1)) {
        # Up to two quotes of content may sit right before the delimiter.
        run = quote_run(line, i)
        if (run >= 3) {
          ML_IN = 0
          from = i + run
        }
        i += run - 1
      }
    } else if (q != "") {
      if (q == "\"" && c == "\\") i++
      else if (c == q) q = ""
    } else if (c == "#") {
      break
    } else if (c == "\"" || c == "\047") {
      run = quote_run(line, i)
      if (run >= 3) {
        ML_CODE = ML_CODE substr(line, from, i - from)
        ML_IN = 1
        ML_DELIM = c c c
        i += 2
      } else if (run == 2) {
        i++
      } else {
        q = c
      }
    }
  }
  if (!ML_IN) ML_CODE = ML_CODE substr(line, from)
  return was_in
}

# Running bracket depth of open multi-line arrays, state in ARR_DEPTH.
# Brackets inside quotes or after a comment do not count. A header line
# opens and closes on itself, so it leaves the depth untouched.
function array_depth_update(line,   i, c, q, d) {
  if (index(line, "[") == 0 && index(line, "]") == 0) return ARR_DEPTH

  q = ""
  d = 0
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (q != "") {
      # A basic string escapes its quote as \" ; a literal one has no escapes.
      if (q == "\"" && c == "\\") i++
      else if (c == q) q = ""
    } else if (c == "\"" || c == "\047") {
      q = c
    } else if (c == "#") {
      break
    } else if (c == "[") {
      d++
    } else if (c == "]") {
      d--
    }
  }

  ARR_DEPTH += d
  if (ARR_DEPTH < 0) ARR_DEPTH = 0
  return ARR_DEPTH
}

# Single entry point every program calls exactly once per line, before
# anything else: it advances the lexical state and reports whether the
# line is the body of a multi-line string or of a multi-line array, both
# of which can hold text that looks like TOML structure but is not.
function skip_line(line,   is_body, inside_array) {
  is_body = in_multiline(line)
  inside_array = (ARR_DEPTH > 0)
  array_depth_update(ML_CODE)
  return is_body || inside_array
}

# Everything before the first # that sits outside quotes. An escaped \"
# inside a basic string is skipped over, not decoded.
function strip_comment(line,   i, c, q) {
  q = ""
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (q != "") {
      if (q == "\"" && c == "\\") i++
      else if (c == q) q = ""
    } else if (c == "\"" || c == "\047") {
      q = c
    } else if (c == "#") {
      return substr(line, 1, i - 1)
    }
  }
  return line
}

# Splits a dotted key into parts[], leaving dots inside quotes alone, and
# trimming the blanks TOML allows around each dot. An escape such as \"
# inside a basic-quoted part is kept as written. Returns the part count,
# or 0 when any part is not a well-formed key.
function split_path(body, parts,   i, c, q, cur, n) {
  n = 0
  cur = ""
  q = ""
  for (i = 1; i <= length(body); i++) {
    c = substr(body, i, 1)
    if (q != "") {
      cur = cur c
      if (q == "\"" && c == "\\") {
        i++
        cur = cur substr(body, i, 1)
      } else if (c == q) {
        q = ""
      }
    } else if (c == "\"" || c == "\047") {
      q = c
      cur = cur c
    } else if (c == ".") {
      parts[++n] = trim(cur)
      cur = ""
    } else {
      cur = cur c
    }
  }
  if (q != "") return 0
  parts[++n] = trim(cur)
  for (i = 1; i <= n; i++) {
    if (!is_key(parts[i])) return 0
  }
  return n
}

function is_array_table(line) {
  return substr(ltrim(line), 1, 2) == "[["
}

# Normalized dotted path of any line that opens a table -- [x] or [[x]] --
# or "" when the line opens none. Callers that must not treat an
# array-of-tables as a toggleable section pair this with is_array_table();
# every caller still has to close the current section on a non-empty
# result, or the keys of the new table leak into the previous one.
function table_path(line,   t, body, parts, n, i, out) {
  t = ltrim(line)
  if (substr(t, 1, 1) != "[") return ""

  t = rtrim(strip_comment(t))
  if (substr(t, length(t), 1) != "]") return ""

  if (substr(t, 1, 2) == "[[") {
    if (length(t) < 5 || substr(t, length(t) - 1, 1) != "]") return ""
    body = substr(t, 3, length(t) - 4)
  } else {
    if (length(t) < 3) return ""
    body = substr(t, 2, length(t) - 2)
  }

  n = split_path(body, parts)
  if (n == 0) return ""

  out = parts[1]
  for (i = 2; i <= n; i++) out = out "." parts[i]
  return out
}

# Single-key remainder of a path under prefix ("mcp_servers."), unquoted;
# "" when the path is not a direct child, so mcp_servers.foo.env is out.
function child_of(path, prefix,   rest) {
  if (index(path, prefix) != 1) return ""
  rest = substr(path, length(prefix) + 1)
  if (!is_key(rest)) return ""
  return unquote(rest)
}

# Number for a run of hex digits, or -1 when one is not a hex digit.
function hex_value(s,   i, d, n) {
  n = 0
  for (i = 1; i <= length(s); i++) {
    d = index("0123456789abcdef", tolower(substr(s, i, 1)))
    if (d == 0) return -1
    n = n * 16 + d - 1
  }
  return n
}

# A basic-quoted key decoded only as far as comparing it with the ASCII
# names cdxt looks up needs. Any escape that is not ASCII, or is a control
# character, becomes \001, which none of those names holds. \xHH comes from
# TOML 1.1, which Codex reads.
function decode_key(s,   out, i, c, n, h, v) {
  out = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c != "\\") {
      out = out c
      continue
    }
    c = substr(s, ++i, 1)
    n = (c == "u") ? 4 : ((c == "U") ? 8 : ((c == "x") ? 2 : 0))
    if (n > 0) {
      # A short run such as \u64 is invalid, so it must not decode.
      h = substr(s, i + 1, n)
      v = (length(h) == n) ? hex_value(h) : -1
      i += n
      out = out ((v >= 32 && v < 127) ? sprintf("%c", v) : "\001")
    } else if (c == "\"" || c == "\\") {
      out = out c
    } else {
      out = out "\001"
    }
  }
  return out
}

# Key of an assignment line, unquoted; "" when the line is not one. TOML
# reads "enabled", enabled and "enabled" as the same key, so all of
# them have to match.
function key_of(line,   t, p, k) {
  t = ltrim(line)
  p = index(t, "=")
  if (p == 0) return ""
  k = rtrim(substr(t, 1, p - 1))
  if (!is_key(k)) return ""
  if (substr(k, 1, 1) == "\"") return decode_key(unquote(k))
  return unquote(k)
}

function is_enabled_line(line) {
  return key_of(line) == "enabled"
}

# Value of an assignment line, comment and blanks removed.
function value_of(line,   v) {
  v = substr(line, index(line, "=") + 1)
  v = strip_comment(v)
  gsub(/[[:space:]]/, "", v)
  return v
}

# Leading blanks of a line, so rewritten and inserted keys keep the
# indentation style already in the file.
function indent_of(line) {
  if (match(line, /^[[:space:]]+/)) return substr(line, 1, RLENGTH)
  return ""
}
'

typeset -a REGISTRY
typeset -A ENABLED_MAP
typeset -i WROTE=0
ERR_MSG=""
FIX_COMMAND=""
FIX_CWD=""

die() {
  print -u2 -- "$1"
  exit 1
}

# Record an error and print it to stderr. The transform-* branches read
# ERR_MSG afterwards: they cannot capture stderr in a subshell without
# losing the WROTE flag set by do_toggle_index/do_set_index.
fail() {
  ERR_MSG="$1"
  print -ru2 -- "$1"
}

discard_file() {
  if command -v trash >/dev/null 2>&1; then
    trash "$1" 2>/dev/null
  fi
}

prune_backups() {
  local -a backups tmps
  local have_trash=0

  command -v trash >/dev/null 2>&1 && have_trash=1
  (( have_trash )) || return 0

  backups=("$BACKUP_DIR"/config.toml.*(N.om))
  if (( ${#backups[@]} > BACKUP_KEEP )); then
    trash "${backups[@]:$BACKUP_KEEP}" 2>/dev/null
  fi

  # Sweep orphan tmp files (they only persist after failed writes). Only
  # files older than one hour: a fresh tmp may belong to a concurrent cdxt
  # mid-write. Separate pool so the BACKUP_KEEP count is not distorted.
  tmps=("$BACKUP_DIR"/.tmp.config.toml.*(N.mh+1))
  if (( ${#tmps[@]} > 0 )); then
    trash "${tmps[@]}" 2>/dev/null
  fi
}

load_registry() {
  local records

  records="$(awk "$AWK_LIB"'
    function emit() {
      if (section != "") {
        key = label "-" kind
        # A quoted key may hold | or a tab, but never a raw \037.
        print key "\037" kind "\037" section "\037" label
      }
    }

    { if (skip_line($0)) next }

    {
      path = table_path($0)
      if (path == "") next

      emit()

      section = ""
      kind = ""
      label = ""

      # [[x]] declares an array element, not a section cdxt can toggle.
      if (is_array_table($0)) next

      candidate = child_of(path, "mcp_servers.")
      if (candidate != "") {
        section = path
        label = candidate
        kind = "mcp"
        next
      }

      candidate = child_of(path, "plugins.")
      if (candidate != "") {
        section = path
        label = candidate
        kind = "plugin"
      }
    }

    END {
      emit()
    }
  ' "$CONFIG")" || {
    REGISTRY=()
    return 1
  }

  if [[ -z "$records" ]]; then
    REGISTRY=()
    return 1
  fi

  REGISTRY=("${(@f)records}")
}

parse_record() {
  local record="$1"
  local IFS=$'\037'
  read -r TOOL_KEY TOOL_KIND TOOL_SECTION TOOL_LABEL <<< "$record"
}

enabled_value() {
  local section="$1"

  CDXT_TARGET="$section" awk "$AWK_LIB"'
    BEGIN { target = ENVIRON["CDXT_TARGET"] }

    { if (skip_line($0)) next }

    {
      path = table_path($0)
      if (path != "") {
        if (in_target) {
          in_target = 0
          print "true"
          exit
        }

        if (path == target && !is_array_table($0)) {
          in_target = 1
          found_section = 1
        }
        next
      }
    }

    in_target && is_enabled_line($0) {
      in_target = 0
      print value_of($0)
      exit
    }

    END {
      if (found_section && in_target) {
        print "true"
      }
    }
  ' "$CONFIG"
}

load_enabled_map() {
  local section value

  ENABLED_MAP=()

  while IFS=$'\037' read -r section value; do
    ENABLED_MAP[$section]="$value"
  done < <(awk "$AWK_LIB"'
    function flush() {
      if (section != "") {
        print section "\037" value
      }
    }

    { if (skip_line($0)) next }

    {
      path = table_path($0)
      if (path != "") {
        flush()
        # An array-of-tables body is left untracked, so its keys cannot be
        # mistaken for the enclosing table ones.
        section = is_array_table($0) ? "" : path
        value = "true"
        next
      }
    }

    section != "" && is_enabled_line($0) {
      value = value_of($0)
    }

    END {
      flush()
    }
  ' "$CONFIG")
}

# True (exit 0) if the section already contains an `enabled = ...` line.
# write_enabled_value must know this up front: its awk pass is single-pass
# and would otherwise insert a duplicate key above an existing one.
section_has_enabled() {
  local section="$1"

  CDXT_TARGET="$section" awk "$AWK_LIB"'
    BEGIN { target = ENVIRON["CDXT_TARGET"] }

    { if (skip_line($0)) next }

    {
      path = table_path($0)
      if (path != "") {
        if (in_target) exit

        if (path == target && !is_array_table($0)) in_target = 1
        next
      }
    }

    in_target && is_enabled_line($0) {
      found = 1
      exit
    }

    END {
      exit found ? 0 : 1
    }
  ' "$CONFIG"
}

# The url, command and cwd of a section, one "key|raw value" line each,
# comment stripped and value still TOML-encoded.
launch_keys() {
  local section="$1"

  CDXT_TARGET="$section" awk "$AWK_LIB"'
    BEGIN { target = ENVIRON["CDXT_TARGET"] }

    { if (skip_line($0)) next }

    {
      path = table_path($0)
      if (path != "") {
        if (in_target) exit

        if (path == target && !is_array_table($0)) in_target = 1
        next
      }
    }

    in_target {
      key = key_of($0)
      if ((key == "url" || key == "command" || key == "cwd") && !(key in seen)) {
        seen[key] = 1
        print key "|" trim(strip_comment(substr($0, index($0, "=") + 1)))
      }
    }
  ' "$CONFIG"
}

# Decodes a single-line TOML string into REPLY. Only the \\ and \" escapes
# are decoded; any other escape, a multi-line string or a non-string value
# returns 1, so a path is never judged by a spelling it was not written in.
toml_string() {
  local raw="$1" body out="" c
  local -i i

  case "$raw" in
    \"\"\"*|\'\'\'*)
      return 1
      ;;
    \'*\')
      REPLY="${raw[2,-2]}"
      [[ "$REPLY" != *\'* ]]
      return
      ;;
    \"*\")
      body="${raw[2,-2]}"
      ;;
    *)
      return 1
      ;;
  esac

  for (( i = 1; i <= ${#body}; i++ )); do
    c="${body[i]}"
    [[ "$c" == \" ]] && return 1
    if [[ "$c" == \\ ]]; then
      (( i++ ))
      c="${body[i]}"
      [[ "$c" == \\ || "$c" == \" ]] || return 1
    fi
    out+="$c"
  done

  REPLY="$out"
}

toml_quote() {
  local s="${1//\\/\\\\}"
  REPLY="\"${s//\"/\\\"}\""
}

# Runs before an MCP server is enabled. Codex resolves a relative command
# against the directory each session starts in, so such a server starts
# from one folder only. When exactly one copy of the target exists under
# the config directory, FIX_COMMAND (and FIX_CWD for a relative cwd) point
# at it; with none or several, the enable is refused. Bare names go through
# Codex's PATH, which may differ from this shell's, and `~` expansion is
# unverified: both pass untouched.
prepare_mcp_enable() {
  local key raw command rel root match base target cwd
  local -A values
  local -a bases

  FIX_COMMAND=""
  FIX_CWD=""
  [[ "$TOOL_KIND" == mcp ]] || return 0

  while IFS='|' read -r key raw; do
    values[$key]="$raw"
  done < <(launch_keys "$TOOL_SECTION")

  (( ${+values[url]} )) && return 0
  (( ${+values[command]} )) || return 0
  if ! toml_string "${values[command]}"; then
    fail "$TOOL_LABEL was not enabled: could not read its command, write it as a plain string: ${values[command]}. Nothing was changed."
    return 1
  fi
  command="$REPLY"

  [[ "$command" == */* && "$command" != \~* ]] || return 0

  if [[ "$command" == /* ]]; then
    [[ -f "$command" && -x "$command" ]] && return 0
    fail "$TOOL_LABEL was not enabled: command not found or not executable: $command. Nothing was changed."
    return 1
  fi

  rel="$command"
  while [[ "$rel" == ./* ]]; do
    rel="${rel#./}"
  done

  # A parent reference leaves the starting folder ambiguous.
  if [[ "/$rel/" == */../* ]]; then
    fail "$TOOL_LABEL was not enabled: its relative command climbs out of the folder Codex starts in, set an absolute path: $command. Nothing was changed."
    return 1
  fi

  # Matches are not pruned: a copy nested inside another one still counts
  # against uniqueness.
  root="${CONFIG:h}"
  bases=()
  while IFS= read -r -d '' match; do
    base="${match:h}"
    [[ -f "$base/$rel" && -x "$base/$rel" ]] && bases+=("$base")
  done < <(find "$root" -maxdepth 6 \
    \( -name sessions -o -name archived_sessions -o -name .git -o -name node_modules \) -prune \
    -o -name "${(b)rel%%/*}" -print0 2>/dev/null)

  if (( ${#bases[@]} == 0 )); then
    fail "$TOOL_LABEL was not enabled: its relative command depends on the folder Codex starts in, and no copy of it was found under $root: $command. Nothing was changed."
    return 1
  fi

  if (( ${#bases[@]} > 1 )); then
    fail "$TOOL_LABEL was not enabled: its relative command matches ${#bases[@]} copies under $root, set an absolute path: $command. Nothing was changed."
    return 1
  fi

  base="${bases[1]}"
  target="$base/$rel"

  # A symlink could send the command anywhere on disk.
  if [[ "${target:A}" != "$root"/* ]]; then
    fail "$TOOL_LABEL was not enabled: its only copy resolves outside $root, set an absolute path: $command. Nothing was changed."
    return 1
  fi

  # A relative cwd was written for the same starting folder as the command.
  cwd=""
  if (( ${+values[cwd]} )); then
    if ! toml_string "${values[cwd]}"; then
      fail "$TOOL_LABEL was not enabled: could not read its cwd, write it as a plain string: ${values[cwd]}. Nothing was changed."
      return 1
    fi
    cwd="$REPLY"
    if [[ "$cwd" == /* || "$cwd" == \~* ]]; then
      cwd=""
    else
      cwd="${cwd#./}"
      if [[ -z "$cwd" || "$cwd" == . ]]; then
        cwd="$base"
      else
        cwd="$base/$cwd"
      fi
    fi
  fi

  # A raw control character would end the single-line TOML string.
  if [[ "$target" == *[[:cntrl:]]* ]]; then
    fail "$TOOL_LABEL was not enabled: the path of its only copy holds a control character, set an absolute path: $command. Nothing was changed."
    return 1
  fi

  if [[ "$cwd" == *[[:cntrl:]]* ]]; then
    fail "$TOOL_LABEL was not enabled: its cwd holds a control character, set an absolute cwd: ${values[cwd]}. Nothing was changed."
    return 1
  fi

  toml_quote "$target"
  FIX_COMMAND="$REPLY"
  if [[ -n "$cwd" ]]; then
    toml_quote "$cwd"
    FIX_CWD="$REPLY"
  fi

  return 0
}

write_enabled_value() {
  local section="$1"
  local value="$2"
  local command="${3:-}"
  local cwd="${4:-}"
  local timestamp backup tmp has_enabled

  mkdir -p "$BACKUP_DIR" || return 1

  timestamp="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  backup="$BACKUP_DIR/config.toml.$timestamp"
  tmp="$BACKUP_DIR/.tmp.config.toml.$timestamp"

  cp "$CONFIG" "$backup" || return 1
  cp -p "$CONFIG" "$tmp" || return 1

  has_enabled=0
  section_has_enabled "$section" && has_enabled=1

  # The rewritten values travel through ENVIRON: awk -v would decode the
  # backslashes of a TOML-escaped path.
  CDXT_TARGET="$section" CDXT_COMMAND="$command" CDXT_CWD="$cwd" \
  awk -v desired="$value" -v has_enabled="$has_enabled" "$AWK_LIB"'
    function flush_blanks(   i) {
      for (i = 1; i <= nblank; i++) print blanks[i]
      nblank = 0
    }

    # Keeps the line own spelling of the key -- indentation, blanks and
    # quotes alike -- and whatever comment trailed the value.
    function assign(line, value,   eq, head, rest, suffix) {
      eq = index(line, "=")
      head = substr(line, 1, eq)
      rest = substr(line, eq + 1)
      suffix = ltrim(substr(rest, length(strip_comment(rest)) + 1))
      sub(/\r$/, "", suffix)
      if (suffix != "") suffix = " " suffix
      return head " " value suffix
    }

    BEGIN {
      target = ENVIRON["CDXT_TARGET"]
      if (ENVIRON["CDXT_COMMAND"] != "") replace["command"] = ENVIRON["CDXT_COMMAND"]
      if (ENVIRON["CDXT_CWD"] != "") replace["cwd"] = ENVIRON["CDXT_CWD"]
    }

    { if (skip_line($0)) { print; next } }

    {
      path = table_path($0)
      if (path != "") {
        # The target section ends here: emit the key it never had, ahead
        # of the blank lines that were trailing it.
        if (in_target && inserted == 0) {
          print key_indent "enabled = " desired cr
          inserted = 1
        }
        flush_blanks()
        in_target = 0

        if (path == target && !is_array_table($0)) {
          in_target = 1
          inserted = 0
          nblank = 0
          # Fallback indentation for a section with no keys: one step in
          # from its header. A section that has keys reuses their own.
          key_indent = indent_of($0) "  "
          # Line ending of the file, so generated lines match it.
          cr = ($0 ~ /\r$/) ? "\r" : ""
        }

        print
        next
      }
    }

    # Paths resolved by prepare_mcp_enable, first occurrence only.
    in_target && (key_of($0) in replace) {
      flush_blanks()
      key = key_of($0)
      print assign($0, replace[key]) cr
      delete replace[key]
      next
    }

    # Only the first enabled key of the section is rewritten: a second one
    # would already be invalid TOML, and touching it would edit the file
    # further than asked.
    in_target && !inserted && is_enabled_line($0) {
      flush_blanks()
      print assign($0, desired) cr
      inserted = 1
      next
    }

    # Blank lines are held back while the insertion point is still open, so
    # a key added to a section with no keys lands under its header instead
    # of after the blank line that separates it from the next table.
    in_target && !inserted && $0 ~ /^[[:space:]]*$/ {
      blanks[++nblank] = $0
      next
    }

    in_target && !has_enabled && !inserted && $0 !~ /^[[:space:]]*#/ && NF > 0 {
      # No enabled key anywhere in this section: insert at the first
      # non-blank, non-comment line so it sits right below the header,
      # matching that line indentation.
      flush_blanks()
      print indent_of($0) "enabled = " desired cr
      print
      inserted = 1
      in_target = 0
      next
    }

    {
      flush_blanks()
      print
    }

    END {
      if (in_target && inserted == 0) {
        print key_indent "enabled = " desired cr
      }
      flush_blanks()
    }
  ' "$CONFIG" > "$tmp" || {
    discard_file "$tmp"
    return 1
  }

  mv "$tmp" "$CONFIG" || {
    discard_file "$tmp"
    return 1
  }

  prune_backups

  # With CODEX_CONFIG_BACKUP_KEEP=0 the backup is pruned immediately.
  if [[ -f "$backup" ]]; then
    print -- "Backup: $backup"
  fi

  return 0
}

status_label() {
  case "$1" in
    true)
      print -- "ON"
      ;;
    false)
      print -- "OFF"
      ;;
    *)
      print -- "???"
      ;;
  esac
}

status_cell() {
  case "$1" in
    true)
      REPLY=$' \033[1;32m● ON \033[0m'
      ;;
    false)
      REPLY=$' \033[38;2;98;114;164m○ OFF\033[0m'
      ;;
    *)
      REPLY=$' \033[33m? ???\033[0m'
      ;;
  esac
}

kind_cell() {
  case "$1" in
    mcp)
      REPLY=$'   \033[36mmcp   \033[0m   '
      ;;
    plugin)
      REPLY=$'   \033[35mplugin\033[0m   '
      ;;
    *)
      REPLY="   $1   "
      ;;
  esac
}

print_path_fixes() {
  [[ -n "$FIX_COMMAND" ]] && print -r -- "$TOOL_LABEL: command = $FIX_COMMAND"
  [[ -n "$FIX_CWD" ]] && print -r -- "$TOOL_LABEL: cwd = $FIX_CWD"
  return 0
}

print_restart_note() {
  print -- ""
  print -- "Restart Codex or open a new session to reload the tool list."
  print -- "In the current session the config file changes, but the model's tools are not reloaded dynamically."
}

toggle_index() {
  do_toggle_index "$@" || exit 1
}

set_index() {
  do_set_index "$@" || exit 1
}

# Returns 0 on success, 1 on error. Errors go through fail() (stderr + ERR_MSG).
# Sets WROTE=1 if the file was actually written.
# If show_note is "yes", prints the restart hint on success.
do_toggle_index() {
  local index="$1"
  local show_note="${2:-yes}"
  local record current next label

  if ! [[ "$index" == <-> ]]; then
    fail "Invalid choice: $index"
    return 1
  fi

  if (( index < 1 || index > ${#REGISTRY[@]} )); then
    fail "Choice out of range: $index"
    return 1
  fi

  record="${REGISTRY[$index]}"
  parse_record "$record"
  current="$(enabled_value "$TOOL_SECTION")"

  case "$current" in
    true)
      next=false
      ;;
    false)
      next=true
      ;;
    *)
      fail "Could not find enabled=true/false in [$TOOL_SECTION]. Nothing was changed."
      return 1
      ;;
  esac

  FIX_COMMAND=""
  FIX_CWD=""
  if [[ "$next" == true ]] && ! prepare_mcp_enable; then
    return 1
  fi

  if ! write_enabled_value "$TOOL_SECTION" "$next" "$FIX_COMMAND" "$FIX_CWD"; then
    fail "Failed to update $CONFIG"
    return 1
  fi
  WROTE=1
  label="$(status_label "$next")"

  print_path_fixes
  print -r -- "$TOOL_LABEL is now $label."

  if [[ "$show_note" == "yes" ]]; then
    print_restart_note
  fi
}

# Returns 0 on success, 1 on error. Errors go through fail() (stderr + ERR_MSG).
# Sets WROTE=1 if the file was actually written.
# If show_note is "yes", prints the restart hint on success.
# If the section is already in the desired state, succeeds silently.
do_set_index() {
  local index="$1"
  local desired="$2"
  local show_note="${3:-yes}"
  local record current label

  if ! [[ "$index" == <-> ]]; then
    fail "Invalid choice: $index"
    return 1
  fi

  if (( index < 1 || index > ${#REGISTRY[@]} )); then
    fail "Choice out of range: $index"
    return 1
  fi

  case "$desired" in
    true|false)
      ;;
    *)
      fail "Invalid state: $desired (expected true or false)"
      return 1
      ;;
  esac

  record="${REGISTRY[$index]}"
  parse_record "$record"
  current="$(enabled_value "$TOOL_SECTION")"

  case "$current" in
    true|false)
      ;;
    *)
      fail "Could not find enabled=true/false in [$TOOL_SECTION]. Nothing was changed."
      return 1
      ;;
  esac

  if [[ "$current" == "$desired" ]]; then
    return 0
  fi

  FIX_COMMAND=""
  FIX_CWD=""
  if [[ "$desired" == true ]] && ! prepare_mcp_enable; then
    return 1
  fi

  if ! write_enabled_value "$TOOL_SECTION" "$desired" "$FIX_COMMAND" "$FIX_CWD"; then
    fail "Failed to update $CONFIG"
    return 1
  fi
  WROTE=1
  label="$(status_label "$desired")"

  print_path_fixes
  print -r -- "$TOOL_LABEL is now $label."

  if [[ "$show_note" == "yes" ]]; then
    print_restart_note
  fi
}

show_menu() {
  local interactive="${1:-}"
  local index=1
  local record current label

  load_enabled_map

  print -- ""
  print -- "Codex tools toggle"
  print -- "Config: $CONFIG"
  print -- "MCP servers and plugins found in the config."
  print -- ""

  for record in "${REGISTRY[@]}"; do
    parse_record "$record"
    current="${ENABLED_MAP[$TOOL_SECTION]:-}"
    label="$(status_label "$current")"
    printf '%2d) [%-3s] %-7s %s\n' "$index" "$label" "$TOOL_KIND" "$TOOL_LABEL"
    index=$((index + 1))
  done

  if [[ "$interactive" == "interactive" ]]; then
    print -- ""
    print -- "Type a number to toggle, 'a' to refresh, 'q' to quit, or press Enter to quit."
    print -- "Run 'cdxt help' for all commands."
  else
    print -- ""
    print -- "Run 'cdxt help' for all commands."
  fi
}

text_menu() {
  local choice

  while true; do
    show_menu interactive
    printf '> '
    read -r choice || return 0  # EOF (Ctrl-D) → quit

    case "$choice" in
      ''|q|Q|quit|exit)
        return 0
        ;;
      a|A)
        load_registry
        continue
        ;;
      <->)
        do_toggle_index "$choice" || sleep 1
        load_registry
        continue
        ;;
      *)
        print -u2 -- "Invalid choice: $choice"
        sleep 1
        continue
        ;;
    esac
  done
}

fzf_rows() {
  local index=1
  local record state kind

  load_enabled_map

  for record in "${REGISTRY[@]}"; do
    parse_record "$record"
    status_cell "${ENABLED_MAP[$TOOL_SECTION]:-}"
    state="$REPLY"
    kind_cell "$TOOL_KIND"
    kind="$REPLY"
    printf '%s\t%s\t%s\t%s\n' "$index" "$state" "$kind" "$TOOL_LABEL"
    index=$((index + 1))
  done
}

# Reply for the fzf transform bindings: refresh the list (and restore the
# normal footer) after a write; surface the error in the footer otherwise.
# Parentheses become brackets — a literal `)` would end the fzf action.
transform_reply() {
  local msg

  if (( WROTE )); then
    print -n -- "reload-sync(${SCRIPT_PATH:q} rows)+change-footer($FZF_FOOTER)"
    return 0
  fi

  # -r keeps print from decoding escapes such as \x29 back into a `)`
  # taken from a config value.
  if [[ -n "$ERR_MSG" ]]; then
    msg="${ERR_MSG//\(/[}"
    msg="${msg//\)/]}"
    msg="${msg//[[:cntrl:]]/ }"
    print -rn -- "change-footer($msg)"
  fi

  return 0
}

fzf_menu() {
  local script rc gap=1

  script="${SCRIPT_PATH:q}"

  # No --height on purpose: omitting it makes fzf run fullscreen and follow
  # the real terminal size, so a maximized window is filled to the bottom
  # without an empty band below the box, and the gaps fit. --height would
  # instead open an inline window below the cursor; the script already
  # clears the screen, so fullscreen is the right fit.

  fzf_rows | fzf \
    --ansi \
    --no-sort \
    --track \
    --id-nth=1 \
    --gap="$gap" \
    --gap-line='' \
    --layout=reverse \
    --style=full:rounded \
    --border=rounded \
    --border-label=' Codex tools ' \
    --border-label-pos=3 \
    --padding=0,1 \
    --tabstop=1 \
    --info=inline-right \
    --prompt='❯ ' \
    --pointer='' \
    --footer="$FZF_FOOTER" \
    --color='hl:#f1fa8c,hl+:#f1fa8c,bg+:#343746,info:#6272a4,footer:#6272a4,scrollbar:#6272a4,border:dim,label:#f8f8f2:bold' \
    --delimiter=$'\t' \
    --with-nth='2..' \
    --bind="space:transform($script transform-toggle {1})" \
    --bind="right:transform($script transform-set {1} true)" \
    --bind="left:transform($script transform-set {1} false)" \
    >/dev/null
  rc=$?

  if (( rc == 2 )); then
    print -u2 -- "fzf exited with an error; falling back to the text menu."
    text_menu
    return
  fi

  print -- "If you toggled anything, restart Codex or open a new session to reload the tools."
}

fzf_supported() {
  local version

  command -v fzf >/dev/null 2>&1 || return 1

  version="$(fzf --version 2>/dev/null)" || return 1
  version="${version%% *}"

  autoload -Uz is-at-least
  is-at-least "$FZF_MIN_VERSION" "$version"
}

interactive_menu() {
  [[ -t 1 ]] && clear

  if fzf_supported && [[ -t 0 && -t 1 ]]; then
    fzf_menu
    return
  fi

  text_menu
}

print_help() {
  print -- "cdxt — toggle MCP servers and plugins in the Codex CLI config"
  print -- ""
  print -- "Usage:"
  print -- "  cdxt              open the interactive menu (fzf UI if available, text menu otherwise)"
  print -- "  cdxt list         print the numbered list with ON/OFF status"
  print -- "  cdxt toggle N     toggle item N"
  print -- "  cdxt set N STATE  force item N to a state (true or false)"
  print -- "  cdxt help         show this help"
  print -- "  cdxt version      show cdxt version"
  print -- ""
  print -- "Environment variables:"
  print -- "  CODEX_CONFIG               path to config.toml (default: \$CODEX_HOME/config.toml or ~/.codex/config.toml)"
  print -- "  CODEX_HOME                 Codex directory (default: ~/.codex); CODEX_CONFIG and CODEX_CONFIG_BACKUP_DIR default to \$CODEX_HOME/"
  print -- "  CODEX_CONFIG_BACKUP_DIR    backup directory (default: \$CODEX_HOME/config.toml.backups)"
  print -- "  CODEX_CONFIG_BACKUP_KEEP   number of backups to keep (default: 20)"
}

print_version() {
  print -- "cdxt $VERSION"
}

main() {
  # Help and version are always available, even when the config is missing
  # or has no sections — so `cdxt help` works as an installation check.
  case "${1:-menu}" in
    help|-h|--help)
      print_help
      return 0
      ;;
    version|--version|-v)
      print_version
      return 0
      ;;
  esac

  if ! [[ "$BACKUP_KEEP" == <-> ]]; then
    die "CODEX_CONFIG_BACKUP_KEEP must be a non-negative integer (got: $BACKUP_KEEP)"
  fi

  [[ -f "$CONFIG" ]] || die "Config not found: $CONFIG"

  # Resolve symlinks so the rewrite replaces the real file, not the link
  # (protects dotfile setups managed with stow/chezmoi).
  CONFIG="${CONFIG:A}"

  load_registry

  if (( ${#REGISTRY[@]} == 0 )); then
    die "No MCP servers or plugins found in $CONFIG"
  fi

  case "${1:-menu}" in
    menu)
      interactive_menu
      ;;
    list)
      show_menu
      ;;
    rows)
      fzf_rows
      ;;
    toggle)
      [[ $# -ge 2 ]] || die "Missing item number. Example: cdxt toggle 6"
      toggle_index "$2"
      ;;
    transform-toggle)
      [[ $# -ge 2 ]] || die "Missing item number. Example: cdxt transform-toggle 6"
      WROTE=0
      ERR_MSG=""
      do_toggle_index "$2" no >/dev/null 2>&1
      transform_reply
      ;;
    set)
      [[ $# -ge 3 ]] || die "Missing item number and state. Example: cdxt set 6 true"
      set_index "$2" "$3"
      ;;
    transform-set)
      [[ $# -ge 3 ]] || die "Missing item number and state. Example: cdxt transform-set 6 true"
      WROTE=0
      ERR_MSG=""
      do_set_index "$2" "$3" no >/dev/null 2>&1
      transform_reply
      ;;
    *)
      die "Unknown command: $1 (run 'cdxt help' for usage)"
      ;;
  esac
}

main "$@"
